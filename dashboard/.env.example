# Copy this file to .env (local dev) or configure the same keys as
# environment variables in the Vercel project settings (production).
# Do not commit real values -- this file is a template only.

# --- Database --------------------------------------------------------------

# Postgres connection string (Drizzle + NextAuth's DrizzleAdapter both use
# this). Vercel Postgres / Neon / Supabase all provide one in this form.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Auth.js (NextAuth v5) session ------------------------------------------

# Random secret used to sign/encrypt session cookies. Generate with:
#   npx auth secret
AUTH_SECRET=

# Only required in production if Auth.js can't infer the deployment's own
# URL (e.g. a custom domain in front of Vercel). Usually unnecessary on a
# plain *.vercel.app deployment.
# AUTH_URL=https://your-deployment-domain.com

# --- GitHub OAuth (sign-in) --------------------------------------------------

# Credentials for the GitHub OAuth App used for user sign-in (Settings ->
# Developer settings -> OAuth Apps). Distinct from the GitHub App below.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- GitHub App (PR automation) ---------------------------------------------

# Credentials for the GitHub App installed on the target repo(s), used to
# read PR files and merge approved patches (Settings -> Developer settings
# -> GitHub Apps).
GITHUB_APP_ID=
GITHUB_CLIENT_ID=

# The App's private key (.pem). Paste it with literal "\n" in place of real
# newlines -- src/lib/github.ts restores them at runtime.
GITHUB_PRIVATE_KEY=

# Shared secret configured on the GitHub App's webhook, used to verify
# incoming webhook payloads in src/app/api/webhook/route.ts.
GITHUB_WEBHOOK_SECRET=

# --- LLM ---------------------------------------------------------------------

# Groq API key used to generate patches (src/lib/generate-patch.ts).
GROQ_API_KEY=
